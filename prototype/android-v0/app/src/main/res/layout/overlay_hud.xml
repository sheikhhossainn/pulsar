<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_margin="16dp"
    android:background="@drawable/hud_card_background"
    android:elevation="8dp"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/indicatorDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/dot_active" />

        <TextView
            android:id="@+id/tvHudStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/status_listening"
            android:textColor="@color/pulsar_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseHud"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/pulsar_text_secondary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTranscribedQuery"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="বলুন, আমি শুনছি…"
        android:textColor="@color/pulsar_teal"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/tvHudResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text=""
        android:textColor="@color/pulsar_text_secondary"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>
